# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=cat4u

# URL base dell'applicazione (con lo slash finale)
APP_URL=http://localhost/cat4u/



# Configurazione invio email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=
MAIL_FROM_NAME=Cat4U
# --- Proxy / IP reale (produzione dietro reverse proxy) ---
# In locale/hosting diretto: false (si usa REMOTE_ADDR).
# Su Railway/Render/Fly: true.
TRUST_PROXY=false
# Numero di proxy fidati davanti all'app (di solito 1 su questi host).
TRUSTED_PROXY_DEPTH=1
# Opzionale: header a valore singolo con l'IP reale, se la piattaforma lo offre
# (es. Fly.io -> Fly-Client-IP). Vuoto = si usa X-Forwarded-For.
REAL_IP_HEADER=