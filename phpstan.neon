parameters:
    level: 3
    paths:
        - config
        - dashboard
        - admin
        - public
        - partials
        - views
        - index.php
    ignoreErrors:
        - '#Variable \$pdo might not be defined#'
        - '#Variable \$log might not be defined#'
        - '#Variable \$error might not be defined#'
        - '#Variable \$success might not be defined#'