# ==========================================================================
# .htaccess (RADICE) — Configurazione Apache per Cat4U  [VERSIONE CORRETTA]
# ==========================================================================
# Va posizionato nella radice del progetto e DEVE chiamarsi esattamente
# ".htaccess" (con due "t": è l'errore di battitura da correggere).
#
# Rispetto alla vecchia versione di backup, qui:
#   - config/ e logs/ restano bloccati (nessuno deve leggerli dal web)
#   - uploads/ NON è più bloccato in blocco: i PDF e i QR devono essere
#     scaricabili dal pubblico. La protezione di uploads/ è demandata a un
#     .htaccess dedicato dentro quella cartella (impedisce l'esecuzione di PHP).
#   - resta la riscrittura verso il front controller per gli URL puliti.

# Disattiva il listing automatico delle cartelle prive di index.
Options -Indexes

# --------------------------------------------------------------------------
# Blocco accesso diretto a file sensibili (per estensione)
# --------------------------------------------------------------------------
# Nega il download via web di .env, log, dump SQL, lock e file .json di
# configurazione (composer.json, package.json…). Restano leggibili dal PHP.
#
# Sintassi Apache 2.4 (attuale). Su server molto vecchi (2.2) l'equivalente è:
#     Order allow,deny
#     Deny from all
<FilesMatch "\.(env|log|sql|lock|json|bak)$">
    Require all denied
</FilesMatch>

# --------------------------------------------------------------------------
# Riscrittura URL (mod_rewrite)
# --------------------------------------------------------------------------
RewriteEngine On

# Radice rispetto a cui valgono le regole. Allineala alla sottocartella reale
# dell'app: se sposti il progetto (o vai in produzione) aggiorna questo valore.
RewriteBase /cat4u/

# Blocca l'accesso diretto via web SOLO alle cartelle realmente interne.
# uploads/ è volutamente ESCLUSA: i suoi file statici (PDF/QR) devono essere
# raggiungibili. [F] = 403 Forbidden, [L] = ultima regola se combacia.
RewriteRule ^(config|logs|partials|vendor|node_modules|\.git)/ - [F,L]

# Se il percorso richiesto è un file reale (-f) o una cartella reale (-d),
# NON riscrivere: serve direttamente (asset CSS, immagini, PDF, QR, e anche le
# pagine .php raggiunte per percorso diretto come dashboard/login.php).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tutto il resto → front controller, col percorso passato in _route.
#   /cat4u/acme            → index.php?_route=acme
#   /cat4u/acme/volantino  → index.php?_route=acme/volantino
# [QSA] conserva eventuali parametri già in query string; [L] ultima regola.
RewriteRule ^(.*)$ index.php?_route=$1 [QSA,L]